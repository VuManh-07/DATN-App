# Copy to .env and adjust. .env is gitignored; this file is the documented
# template, so every variable the app reads should appear here.

# Base URL of the backend API. Read by the Electron main process at startup.
API_BASE_URL=http://localhost:1255/api/v1

# HTTP timeout for server calls, in milliseconds.
API_TIMEOUT=20000

# Extra logging in the main process: 1 to enable.
DEBUG=0

# ---------------------------------------------------------------------------
# Renderer-visible variables
# ---------------------------------------------------------------------------
# Anything listed in RENDERER_ENV (webpack.plugins.ts) is substituted into the
# renderer bundle at build time, which means it is readable by anyone with the
# app. Use it for endpoints and public identifiers only, never for a secret.
